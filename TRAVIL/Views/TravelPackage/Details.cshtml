@{
    ViewData["Title"] = "Package Details";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Package Details - TRAVEL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --color-midnight: #0d1117;
            --color-navy: #161b22;
            --color-slate: #21262d;
            --color-charcoal: #30363d;
            --color-steel: #484f58;
            --color-silver: #8b949e;
            --color-mist: #c9d1d9;
            --color-white: #ffffff;
            --color-gold: #d4a853;
            --color-gold-dark: #b8943f;
            --color-gold-muted: rgba(212, 168, 83, 0.15);
            --color-success: #3fb950;
            --color-error: #f85149;
            --color-warning: #d29922;
            --font-display: 'Cormorant Garamond', serif;
            --font-body: 'Outfit', sans-serif;
            --space-1: 4px;
            --space-2: 8px;
            --space-3: 12px;
            --space-4: 16px;
            --space-5: 24px;
            --space-6: 32px;
            --space-7: 48px;
            --space-8: 64px;
            --radius-sm: 6px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-full: 9999px;
            --transition-fast: 0.15s ease;
            --transition-normal: 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background: var(--color-midnight);
            color: var(--color-white);
            line-height: 1.6;
            min-height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* Header */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: var(--space-4) var(--space-6);
            background: rgba(22, 27, 34, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--color-slate);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-midnight);
            font-size: 1.25rem;
        }

        .logo-text {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--color-white);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: var(--space-5);
        }

        .nav-link {
            color: var(--color-silver);
            font-weight: 500;
            transition: color var(--transition-fast);
        }

            .nav-link:hover {
                color: var(--color-gold);
            }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-2);
            padding: var(--space-3) var(--space-5);
            border-radius: var(--radius-md);
            font-weight: 500;
            font-size: 0.9375rem;
            cursor: pointer;
            transition: all var(--transition-fast);
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
            color: var(--color-midnight);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(212, 168, 83, 0.4);
            }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--color-slate);
            color: var(--color-mist);
        }

            .btn-outline:hover {
                border-color: var(--color-gold);
                color: var(--color-gold);
            }

        .btn-danger {
            background: rgba(248, 81, 73, 0.15);
            border: 1px solid rgba(248, 81, 73, 0.3);
            color: var(--color-error);
        }

            .btn-danger:hover {
                background: var(--color-error);
                color: var(--color-white);
            }

        .btn-success {
            background: linear-gradient(135deg, var(--color-success), #2ea043);
            color: var(--color-white);
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(63, 185, 80, 0.4);
            }

        .btn-lg {
            padding: var(--space-4) var(--space-6);
            font-size: 1rem;
        }

        .btn-block {
            width: 100%;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Main Content */
        .main-content {
            padding-top: 80px;
        }

        /* Hero Section */
        .hero {
            position: relative;
            height: 60vh;
            min-height: 400px;
            overflow: hidden;
        }

        .hero-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(13, 17, 23, 0.3) 0%, rgba(13, 17, 23, 0.6) 50%, rgba(13, 17, 23, 1) 100%);
        }

        .hero-content {
            position: absolute;
            bottom: var(--space-7);
            left: 0;
            right: 0;
            padding: 0 var(--space-6);
        }

        .hero-inner {
            max-width: 1400px;
            margin: 0 auto;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            margin-bottom: var(--space-4);
            font-size: 0.875rem;
            color: var(--color-silver);
        }

            .breadcrumb a:hover {
                color: var(--color-gold);
            }

        .hero-title {
            font-family: var(--font-display);
            font-size: 3.5rem;
            font-weight: 600;
            margin-bottom: var(--space-3);
        }

        .hero-location {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            font-size: 1.25rem;
            color: var(--color-gold);
        }

        /* Package Details Section */
        .details-section {
            padding: var(--space-7) var(--space-6);
            margin-top: -var(--space-7);
            position: relative;
        }

        .details-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: var(--space-6);
        }

        /* Cards */
        .card {
            background: var(--color-navy);
            border: 1px solid var(--color-slate);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .card-header {
            padding: var(--space-5);
            border-bottom: 1px solid var(--color-slate);
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

            .card-header h3 {
                font-family: var(--font-display);
                font-size: 1.25rem;
                font-weight: 600;
            }

            .card-header i {
                color: var(--color-gold);
            }

        .card-body {
            padding: var(--space-5);
        }

        /* Description */
        .description {
            color: var(--color-mist);
            line-height: 1.8;
            margin-bottom: var(--space-5);
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-4);
            margin-bottom: var(--space-5);
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-4);
            background: var(--color-slate);
            border-radius: var(--radius-md);
        }

        .feature-icon {
            width: 40px;
            height: 40px;
            background: var(--color-gold-muted);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-gold);
        }

        .feature-label {
            font-size: 0.8125rem;
            color: var(--color-silver);
        }

        .feature-value {
            font-weight: 600;
            color: var(--color-white);
        }

        /* Itinerary */
        .itinerary-item {
            display: flex;
            gap: var(--space-4);
            padding: var(--space-4) 0;
            border-bottom: 1px solid var(--color-slate);
        }

            .itinerary-item:last-child {
                border-bottom: none;
            }

        .itinerary-day {
            width: 60px;
            height: 60px;
            background: var(--color-gold-muted);
            border-radius: var(--radius-md);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .itinerary-day span:first-child {
                font-size: 0.75rem;
                color: var(--color-gold);
                text-transform: uppercase;
            }

            .itinerary-day span:last-child {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--color-gold);
            }

        .itinerary-content h4 {
            font-size: 1rem;
            margin-bottom: var(--space-2);
        }

        .itinerary-content p {
            font-size: 0.875rem;
            color: var(--color-silver);
        }

        /* Reviews */
        .reviews-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: var(--space-5);
        }

        .rating-summary {
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .rating-big {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--color-gold);
        }

        .rating-stars {
            display: flex;
            gap: 2px;
            color: var(--color-gold);
        }

        .rating-count {
            font-size: 0.875rem;
            color: var(--color-silver);
        }

        .review-item {
            padding: var(--space-4) 0;
            border-bottom: 1px solid var(--color-slate);
        }

            .review-item:last-child {
                border-bottom: none;
            }

        .review-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            margin-bottom: var(--space-3);
        }

        .review-avatar {
            width: 40px;
            height: 40px;
            background: var(--color-gold-muted);
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-gold);
            font-weight: 600;
        }

        .review-author {
            font-weight: 500;
        }

        .review-date {
            font-size: 0.8125rem;
            color: var(--color-silver);
        }

        .review-rating {
            margin-left: auto;
            display: flex;
            gap: 2px;
            color: var(--color-gold);
            font-size: 0.875rem;
        }

        .review-text {
            color: var(--color-mist);
            font-size: 0.9375rem;
        }

        /* Sidebar - Booking Card */
        .booking-card {
            position: sticky;
            top: 100px;
        }

        .price-display {
            text-align: center;
            padding-bottom: var(--space-4);
            border-bottom: 1px solid var(--color-slate);
            margin-bottom: var(--space-4);
        }

        .price-current {
            font-family: var(--font-display);
            font-size: 2.5rem;
            font-weight: 600;
            color: var(--color-gold);
        }

        .price-period {
            color: var(--color-silver);
            font-size: 0.9375rem;
        }

        .price-original {
            text-decoration: line-through;
            color: var(--color-steel);
            font-size: 1rem;
            margin-right: var(--space-2);
        }

        .sold-out-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-2);
            padding: var(--space-3);
            background: rgba(248, 81, 73, 0.15);
            border: 1px solid rgba(248, 81, 73, 0.3);
            border-radius: var(--radius-md);
            color: var(--color-error);
            font-weight: 500;
            margin-bottom: var(--space-4);
        }

        .booking-details {
            margin-bottom: var(--space-5);
        }

        .booking-detail-row {
            display: flex;
            justify-content: space-between;
            padding: var(--space-3) 0;
            border-bottom: 1px solid var(--color-slate);
        }

            .booking-detail-row:last-child {
                border-bottom: none;
            }

        .booking-detail-label {
            color: var(--color-silver);
        }

        .booking-detail-value {
            font-weight: 500;
        }

        .booking-actions {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }

        /* Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-3);
        }

        .gallery-item {
            aspect-ratio: 1;
            border-radius: var(--radius-md);
            overflow: hidden;
            cursor: pointer;
        }

            .gallery-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform var(--transition-normal);
            }

            .gallery-item:hover img {
                transform: scale(1.1);
            }

        /* Toast */
        .toast {
            position: fixed;
            bottom: var(--space-5);
            right: var(--space-5);
            background: var(--color-navy);
            border: 1px solid var(--color-slate);
            padding: var(--space-4) var(--space-5);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: var(--space-3);
            transform: translateY(100px);
            opacity: 0;
            transition: all var(--transition-normal);
            z-index: 2000;
        }

            .toast.show {
                transform: translateY(0);
                opacity: 1;
            }

            .toast.success {
                border-color: var(--color-success);
            }

                .toast.success i {
                    color: var(--color-success);
                }

            .toast.error {
                border-color: var(--color-error);
            }

                .toast.error i {
                    color: var(--color-error);
                }

        /* Loading State */
        .loading-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
            gap: var(--space-4);
        }

        .spinner {
            width: 48px;
            height: 48px;
            border: 3px solid var(--color-slate);
            border-top-color: var(--color-gold);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Error State */
        .error-state {
            text-align: center;
            padding: var(--space-8);
        }

            .error-state i {
                font-size: 4rem;
                color: var(--color-error);
                margin-bottom: var(--space-4);
            }

            .error-state h3 {
                font-family: var(--font-display);
                font-size: 1.5rem;
                margin-bottom: var(--space-2);
            }

            .error-state p {
                color: var(--color-silver);
                margin-bottom: var(--space-5);
            }

        /* Empty Reviews */
        .empty-reviews {
            text-align: center;
            padding: var(--space-6);
            color: var(--color-silver);
        }

            .empty-reviews i {
                font-size: 2rem;
                margin-bottom: var(--space-3);
                color: var(--color-steel);
            }

        /* Responsive */
        @@media (max-width: 1024px) {
            .details-container {
                grid-template-columns: 1fr;
            }

            .booking-card {
                position: relative;
                top: 0;
            }

            .hero-title {
                font-size: 2.5rem;
            }
        }

        @@media (max-width: 768px) {
            .header {
                padding: var(--space-3) var(--space-4);
            }

            .nav-links {
                display: none;
            }

            .hero {
                height: 50vh;
            }

            .hero-content {
                padding: 0 var(--space-4);
            }

            .hero-title {
                font-size: 2rem;
            }

            .details-section {
                padding: var(--space-5) var(--space-4);
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">
                <div class="logo-icon"><i class="fas fa-compass"></i></div>
                <span class="logo-text">TRAVEL</span>
            </a>
            <nav class="nav-links">
                <a href="/" class="nav-link">Home</a>
                <a href="/packages" class="nav-link">Packages</a>
                <a href="/destinations" class="nav-link">Destinations</a>
                <a href="/about" class="nav-link">About</a>
                <a href="/account/login" class="btn btn-outline" id="loginBtn">Sign In</a>
                <a href="/account/dashboard" class="btn btn-primary" id="dashboardBtn" style="display: none;">
                    <i class="fas fa-user"></i> Dashboard
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content" id="mainContent">
        <div class="loading-state" id="loadingState">
            <div class="spinner"></div>
            <p>Loading package details...</p>
        </div>
    </main>

    <!-- Toast -->
    <div class="toast" id="toast">
        <i class="fas fa-check-circle"></i>
        <span id="toastMessage">Success!</span>
    </div>

    <script>
        var packageId = @(ViewData["PackageId"] ?? 0);
        var packageData = null;
        var isWishlisted = false;

        // Check auth
        function checkAuth() {
            var token = localStorage.getItem('token');
            if (token) {
                document.getElementById('loginBtn').style.display = 'none';
                document.getElementById('dashboardBtn').style.display = 'inline-flex';
            }
        }

        // Show toast
        function showToast(message, type) {
            type = type || 'success';
            var toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = message;
            toast.className = 'toast ' + type;
            toast.querySelector('i').className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3000);
        }

        // Format date
        function formatDate(dateStr) {
            if (!dateStr) return 'N/A';
            return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // Calculate duration
        function calculateDuration(start, end) {
            if (!start || !end) return 0;
            return Math.ceil((new Date(end) - new Date(start)) / (1000 * 60 * 60 * 24));
        }

        // Get package type name
        function getPackageTypeName(type) {
            var types = ['Adventure', 'Beach', 'Cultural', 'Cruise', 'Safari', 'Ski', 'City Break', 'Honeymoon', 'Family', 'Luxury'];
            return types[type] || 'Travel';
        }

        // Show error
        function showError(message) {
            document.getElementById('mainContent').innerHTML =
                '<div class="error-state">' +
                    '<i class="fas fa-exclamation-circle"></i>' +
                    '<h3>Error</h3>' +
                    '<p>' + message + '</p>' +
                    '<a href="/packages" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back to Packages</a>' +
                '</div>';
        }

        // Load package
        async function loadPackage() {
            if (!packageId || packageId === 0) {
                showError('Invalid package ID');
                return;
            }

            try {
                var response = await fetch('/api/packages/' + packageId);

                if (!response.ok) {
                    showError('Package not found');
                    return;
                }

                var result = await response.json();
                packageData = result.data || result;

                if (!packageData) {
                    showError('Package not found');
                    return;
                }

                await checkWishlist();
                renderPackage();

            } catch (error) {
                console.error('Error:', error);
                showError('Failed to load package details');
            }
        }

        // Check wishlist
        async function checkWishlist() {
            var token = localStorage.getItem('token');
            if (!token) return;

            try {
                var response = await fetch('/api/wishlist', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (response.ok) {
                    var result = await response.json();
                    var wishlist = (result.data || result || []).map(function(w) { return w.packageId; });
                    isWishlisted = wishlist.includes(packageId);
                }
            } catch (error) {
                console.error('Wishlist error:', error);
            }
        }

        // Render package
        function renderPackage() {
            var pkg = packageData;
            var duration = calculateDuration(pkg.startDate, pkg.endDate);
            var hasDiscount = pkg.discountedPrice && pkg.discountedPrice < pkg.price;
            var currentPrice = pkg.discountedPrice || pkg.price;
            var isSoldOut = pkg.availableRooms <= 0;
            var imageUrl = pkg.imageUrl || pkg.images?.[0]?.imageUrl || 'https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=1200&q=80';

            var html = '';

            // Hero Section
            html += '<section class="hero">';
            html += '<img src="' + imageUrl + '" alt="' + (pkg.destination || 'Package') + '" class="hero-image" onerror="this.src=\'https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=1200&q=80\'">';
            html += '<div class="hero-overlay"></div>';
            html += '<div class="hero-content">';
            html += '<div class="hero-inner">';
            html += '<div class="breadcrumb">';
            html += '<a href="/">Home</a>';
            html += '<i class="fas fa-chevron-right"></i>';
            html += '<a href="/packages">Packages</a>';
            html += '<i class="fas fa-chevron-right"></i>';
            html += '<span>' + (pkg.destination || 'Package') + '</span>';
            html += '</div>';
            html += '<h1 class="hero-title">' + (pkg.destination || 'Amazing Destination') + '</h1>';
            html += '<div class="hero-location"><i class="fas fa-map-marker-alt"></i> ' + (pkg.country || 'Worldwide') + '</div>';
            html += '</div>';
            html += '</div>';
            html += '</section>';

            // Details Section
            html += '<section class="details-section">';
            html += '<div class="details-container">';

            // Left Column
            html += '<div class="details-main">';

            // Description Card
            html += '<div class="card" style="margin-bottom: var(--space-5);">';
            html += '<div class="card-header"><i class="fas fa-info-circle"></i><h3>About This Trip</h3></div>';
            html += '<div class="card-body">';
            html += '<p class="description">' + (pkg.description || 'Experience an unforgettable journey to this amazing destination.') + '</p>';

            // Features Grid
            html += '<div class="features-grid">';
            html += '<div class="feature-item"><div class="feature-icon"><i class="far fa-calendar"></i></div><div><div class="feature-label">Duration</div><div class="feature-value">' + duration + ' Days</div></div></div>';
            html += '<div class="feature-item"><div class="feature-icon"><i class="fas fa-tag"></i></div><div><div class="feature-label">Category</div><div class="feature-value">' + getPackageTypeName(pkg.packageType) + '</div></div></div>';
            html += '<div class="feature-item"><div class="feature-icon"><i class="fas fa-bed"></i></div><div><div class="feature-label">Available Rooms</div><div class="feature-value">' + (pkg.availableRooms || 0) + '</div></div></div>';
            html += '<div class="feature-item"><div class="feature-icon"><i class="fas fa-users"></i></div><div><div class="feature-label">Age Limit</div><div class="feature-value">' + (pkg.minimumAge || 0) + '+ years</div></div></div>';
            html += '</div>';
            html += '</div>';
            html += '</div>';

            // Itinerary Card (if available)
            if (pkg.itinerary) {
                html += '<div class="card" style="margin-bottom: var(--space-5);">';
                html += '<div class="card-header"><i class="fas fa-route"></i><h3>Itinerary</h3></div>';
                html += '<div class="card-body">';
                html += '<p class="description">' + pkg.itinerary + '</p>';
                html += '</div>';
                html += '</div>';
            }

            // Gallery Card (if images available)
            if (pkg.images && pkg.images.length > 0) {
                html += '<div class="card" style="margin-bottom: var(--space-5);">';
                html += '<div class="card-header"><i class="fas fa-images"></i><h3>Gallery</h3></div>';
                html += '<div class="card-body">';
                html += '<div class="gallery-grid">';
                for (var i = 0; i < Math.min(pkg.images.length, 8); i++) {
                    html += '<div class="gallery-item"><img src="' + pkg.images[i].imageUrl + '" alt="Gallery ' + (i+1) + '"></div>';
                }
                html += '</div>';
                html += '</div>';
                html += '</div>';
            }

            // Reviews Card
            html += '<div class="card" id="reviews">';
            html += '<div class="card-header"><i class="fas fa-star"></i><h3>Reviews</h3></div>';
            html += '<div class="card-body">';

            if (pkg.reviews && pkg.reviews.length > 0) {
                var avgRating = pkg.reviews.reduce(function(sum, r) { return sum + r.rating; }, 0) / pkg.reviews.length;

                html += '<div class="reviews-header">';
                html += '<div class="rating-summary">';
                html += '<span class="rating-big">' + avgRating.toFixed(1) + '</span>';
                html += '<div>';
                html += '<div class="rating-stars">';
                for (var s = 1; s <= 5; s++) {
                    html += '<i class="' + (s <= Math.round(avgRating) ? 'fas' : 'far') + ' fa-star"></i>';
                }
                html += '</div>';
                html += '<div class="rating-count">' + pkg.reviews.length + ' review' + (pkg.reviews.length > 1 ? 's' : '') + '</div>';
                html += '</div>';
                html += '</div>';
                html += '</div>';

                for (var r = 0; r < pkg.reviews.length; r++) {
                    var review = pkg.reviews[r];
                    html += '<div class="review-item">';
                    html += '<div class="review-header">';
                    html += '<div class="review-avatar">' + (review.userName ? review.userName.charAt(0).toUpperCase() : 'U') + '</div>';
                    html += '<div><div class="review-author">' + (review.userName || 'Anonymous') + '</div><div class="review-date">' + formatDate(review.createdAt) + '</div></div>';
                    html += '<div class="review-rating">';
                    for (var rs = 1; rs <= 5; rs++) {
                        html += '<i class="' + (rs <= review.rating ? 'fas' : 'far') + ' fa-star"></i>';
                    }
                    html += '</div>';
                    html += '</div>';
                    html += '<p class="review-text">' + (review.comment || '') + '</p>';
                    html += '</div>';
                }
            } else {
                html += '<div class="empty-reviews">';
                html += '<i class="far fa-comment-dots"></i>';
                html += '<p>No reviews yet. Be the first to review!</p>';
                html += '</div>';
            }

            html += '</div>';
            html += '</div>';

            html += '</div>'; // End details-main

            // Right Column - Booking Card
            html += '<div>';
            html += '<div class="card booking-card">';
            html += '<div class="card-body">';

            // Price Display
            html += '<div class="price-display">';
            if (hasDiscount) {
                html += '<span class="price-original">$' + pkg.price.toLocaleString() + '</span>';
            }
            html += '<span class="price-current">$' + currentPrice.toLocaleString() + '</span>';
            html += '<span class="price-period"> / person</span>';
            html += '</div>';

            // Sold Out Badge
            if (isSoldOut) {
                html += '<div class="sold-out-badge"><i class="fas fa-times-circle"></i> Sold Out</div>';
            }

            // Booking Details
            html += '<div class="booking-details">';
            html += '<div class="booking-detail-row"><span class="booking-detail-label">Dates</span><span class="booking-detail-value">' + formatDate(pkg.startDate) + ' - ' + formatDate(pkg.endDate) + '</span></div>';
            html += '<div class="booking-detail-row"><span class="booking-detail-label">Duration</span><span class="booking-detail-value">' + duration + ' Days</span></div>';
            html += '<div class="booking-detail-row"><span class="booking-detail-label">Category</span><span class="booking-detail-value">' + getPackageTypeName(pkg.packageType) + '</span></div>';
            html += '</div>';

            // Booking Actions
            html += '<div class="booking-actions">';

            if (isSoldOut) {
                html += '<button class="btn btn-primary btn-lg btn-block" onclick="joinWaitingList()"><i class="fas fa-bell"></i> Join Waiting List</button>';
            } else {
                html += '<a href="/booking/buynow/' + packageId + '" class="btn btn-success btn-lg btn-block"><i class="fas fa-bolt"></i> Book Now</a>';
                html += '<a href="/booking/create/' + packageId + '" class="btn btn-outline btn-lg btn-block"><i class="fas fa-calendar-plus"></i> Reserve</a>';
            }

            html += '<button class="btn btn-outline btn-block" onclick="toggleWishlist()">';
            html += '<i class="' + (isWishlisted ? 'fas' : 'far') + ' fa-heart"></i> ' + (isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist');
            html += '</button>';

            html += '</div>';

            html += '</div>';
            html += '</div>';
            html += '</div>'; // End right column

            html += '</div>'; // End details-container
            html += '</section>';

            document.getElementById('mainContent').innerHTML = html;
        }

        // Join Waiting List - FIXED: Using correct API endpoint
        async function joinWaitingList() {
            var token = localStorage.getItem('token');

            if (!token) {
                showToast('Please login to join the waiting list', 'error');
                setTimeout(function() {
                    window.location.href = '/account/login?returnUrl=/packages/' + packageId;
                }, 1500);
                return;
            }

            try {
                // CORRECT API ENDPOINT: POST /api/booking/waiting-list with JSON body
                var response = await fetch('/api/booking/waiting-list', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        packageId: packageId,
                        numberOfRooms: 1
                    })
                });

                var result = await response.json();

                if (response.ok && result.success) {
                    showToast(result.message || 'Added to waiting list!', 'success');
                } else {
                    showToast(result.message || 'Failed to join waiting list', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Error joining waitlist', 'error');
            }
        }

        // Toggle Wishlist
        async function toggleWishlist() {
            var token = localStorage.getItem('token');

            if (!token) {
                showToast('Please login to manage wishlist', 'error');
                setTimeout(function() {
                    window.location.href = '/account/login?returnUrl=/packages/' + packageId;
                }, 1500);
                return;
            }

            try {
                var response = await fetch('/api/wishlist/' + packageId, {
                    method: isWishlisted ? 'DELETE' : 'POST',
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (response.ok) {
                    isWishlisted = !isWishlisted;
                    showToast(isWishlisted ? 'Added to wishlist' : 'Removed from wishlist', 'success');
                    renderPackage(); // Re-render to update button
                } else {
                    var result = await response.json();
                    showToast(result.message || 'Failed to update wishlist', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Error updating wishlist', 'error');
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            checkAuth();
            loadPackage();
        });
    </script>
</body>
</html>
