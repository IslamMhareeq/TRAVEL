@{
    ViewData["Title"] = "Payment";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Complete Payment - TRAVIL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --color-midnight: #0d1117;
            --color-navy: #161b22;
            --color-slate: #21262d;
            --color-charcoal: #30363d;
            --color-steel: #484f58;
            --color-silver: #8b949e;
            --color-mist: #c9d1d9;
            --color-white: #ffffff;
            --color-gold: #d4a853;
            --color-gold-dark: #b8943f;
            --color-success: #3fb950;
            --color-error: #f85149;
            --color-paypal: #003087;
            --color-paypal-light: #009cde;
            --font-display: 'Cormorant Garamond', serif;
            --font-body: 'Outfit', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background: var(--color-midnight);
            color: var(--color-white);
            min-height: 100vh;
        }

        .ssl-banner {
            background: linear-gradient(90deg, var(--color-success), #2ea043);
            padding: 8px 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            font-size: 13px;
        }

        .lock-icon {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .payment-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 24px;
        }

        .payment-header {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 0;
            border-bottom: 1px solid var(--color-slate);
            margin-bottom: 32px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-midnight);
            font-size: 1.25rem;
        }

        .logo-text {
            font-family: var(--font-display);
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--color-white);
        }

        .page-title {
            text-align: center;
            margin-bottom: 32px;
        }

        .page-title h1 {
            font-family: var(--font-display);
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .page-title p {
            color: var(--color-silver);
        }

        .payment-grid {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 32px;
        }

        .card {
            background: var(--color-navy);
            border: 1px solid var(--color-slate);
            border-radius: 16px;
            overflow: hidden;
        }

        .card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--color-slate);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-header i {
            color: var(--color-gold);
        }

        .card-header h3 {
            font-family: var(--font-display);
            font-size: 1.25rem;
        }

        .card-body {
            padding: 24px;
        }

        /* Payment Methods */
        .payment-methods {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        .payment-method {
            padding: 16px;
            border: 2px solid var(--color-slate);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
        }

        .payment-method:hover {
            border-color: var(--color-gold);
        }

        .payment-method.active {
            border-color: var(--color-gold);
            background: rgba(212, 168, 83, 0.1);
        }

        .payment-method i {
            font-size: 28px;
            margin-bottom: 8px;
            display: block;
        }

        .payment-method.card-method i { color: var(--color-gold); }
        .payment-method.paypal-method i { color: var(--color-paypal-light); }

        .payment-method span {
            font-weight: 500;
            font-size: 14px;
        }

        /* Form Styles */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--color-silver);
        }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            background: var(--color-slate);
            border: 1px solid var(--color-charcoal);
            border-radius: 10px;
            color: var(--color-white);
            font-size: 15px;
            transition: border-color 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--color-gold);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        /* Buttons */
        .btn-pay {
            width: 100%;
            padding: 16px 24px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s;
        }

        .btn-pay-card {
            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
            color: var(--color-midnight);
        }

        .btn-pay-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(212, 168, 83, 0.4);
        }

        .btn-pay-paypal {
            background: var(--color-paypal);
            color: var(--color-white);
        }

        .btn-pay-paypal:hover {
            background: #002366;
            transform: translateY(-2px);
        }

        .btn-pay:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }

        .btn-cancel {
            width: 100%;
            padding: 14px;
            background: transparent;
            border: 1px solid var(--color-slate);
            border-radius: 10px;
            color: var(--color-silver);
            font-size: 14px;
            cursor: pointer;
            margin-top: 16px;
            transition: all 0.2s;
        }

        .btn-cancel:hover {
            border-color: var(--color-error);
            color: var(--color-error);
        }

        /* Order Summary */
        .order-summary {
            position: sticky;
            top: 24px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--color-slate);
        }

        .summary-row:last-child {
            border-bottom: none;
        }

        .summary-row.total {
            font-size: 18px;
            font-weight: 600;
            padding-top: 16px;
            margin-top: 8px;
            border-top: 2px solid var(--color-slate);
        }

        .summary-row.total .value {
            color: var(--color-gold);
        }

        .booking-ref {
            background: var(--color-slate);
            padding: 16px;
            border-radius: 10px;
            margin-top: 16px;
            text-align: center;
        }

        .booking-ref span {
            display: block;
            font-size: 12px;
            color: var(--color-silver);
            margin-bottom: 4px;
        }

        .booking-ref strong {
            font-size: 18px;
            color: var(--color-gold);
            font-family: monospace;
        }

        /* PayPal Section */
        .paypal-section {
            text-align: center;
            padding: 32px 0;
        }

        .paypal-logo {
            font-size: 48px;
            color: var(--color-paypal-light);
            margin-bottom: 16px;
        }

        .paypal-section p {
            color: var(--color-silver);
            margin-bottom: 24px;
        }

        .paypal-info {
            background: rgba(0, 156, 222, 0.1);
            border: 1px solid rgba(0, 156, 222, 0.3);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 24px;
        }

        .paypal-info i {
            color: var(--color-paypal-light);
            margin-right: 8px;
        }

        /* Alerts */
        .alert {
            padding: 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .alert-success {
            background: rgba(63, 185, 80, 0.15);
            border: 1px solid rgba(63, 185, 80, 0.3);
            color: var(--color-success);
        }

        .alert-error {
            background: rgba(248, 81, 73, 0.15);
            border: 1px solid rgba(248, 81, 73, 0.3);
            color: var(--color-error);
        }

        .d-none { display: none !important; }

        /* Loader */
        .loader {
            width: 20px;
            height: 20px;
            border: 2px solid transparent;
            border-top-color: currentColor;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .payment-grid {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
            }
        }

        @@media (max-width: 600px) {
            .payment-methods {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="ssl-banner">
        <div class="lock-icon">
            <i class="fas fa-lock"></i>
            <span>SSL Secured</span>
        </div>
        <span>Your payment information is encrypted and secure</span>
    </div>

    <div class="payment-container">
        <div class="payment-header">
            <a href="/" class="logo">
                <div class="logo-icon"><i class="fas fa-compass"></i></div>
                <span class="logo-text">TRAVIL</span>
            </a>
        </div>

        <div class="page-title">
            <h1>Complete Your Payment</h1>
            <p>Your booking is almost confirmed. Choose your payment method below.</p>
        </div>

        <div class="payment-grid">
            <!-- Payment Form -->
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-credit-card"></i>
                    <h3>Payment Method</h3>
                </div>
                <div class="card-body">
                    <!-- Alert Messages -->
                    <div class="alert alert-error d-none" id="errorAlert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span id="errorMessage"></span>
                    </div>
                    <div class="alert alert-success d-none" id="successAlert">
                        <i class="fas fa-check-circle"></i>
                        <span id="successMessage"></span>
                    </div>

                    <!-- Payment Method Selection -->
                    <div class="payment-methods">
                        <div class="payment-method card-method active" onclick="selectPaymentMethod('card')">
                            <i class="fas fa-credit-card"></i>
                            <span>Credit Card</span>
                        </div>
                        <div class="payment-method paypal-method" onclick="selectPaymentMethod('paypal')">
                            <i class="fab fa-paypal"></i>
                            <span>PayPal</span>
                        </div>
                    </div>

                    <!-- Credit Card Form -->
                    <form id="cardPaymentSection">
                        <div class="form-group">
                            <label class="form-label">Card Number</label>
                            <input type="text" class="form-control" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Cardholder Name</label>
                            <input type="text" class="form-control" id="cardName" placeholder="John Doe">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Expiry Date</label>
                                <input type="text" class="form-control" id="expiry" placeholder="MM/YY" maxlength="5">
                            </div>
                            <div class="form-group">
                                <label class="form-label">CVV</label>
                                <input type="text" class="form-control" id="cvv" placeholder="123" maxlength="4">
                            </div>
                        </div>

                        <button type="submit" class="btn-pay btn-pay-card" id="payCardBtn">
                            <span id="payCardText"><i class="fas fa-lock"></i> Pay Now</span>
                            <div class="loader d-none" id="payCardLoader"></div>
                        </button>
                    </form>

                    <!-- PayPal Section -->
                    <div id="paypalPaymentSection" class="d-none">
                        <div class="paypal-section">
                            <div class="paypal-logo"><i class="fab fa-paypal"></i></div>
                            <div class="paypal-info">
                                <i class="fas fa-info-circle"></i>
                                You will be redirected to PayPal to complete your payment securely.
                            </div>
                            <p>Click the button below to proceed to PayPal's secure checkout.</p>
                            <button type="button" class="btn-pay btn-pay-paypal" id="paypalBtn" onclick="processPayPal()">
                                <span id="paypalText"><i class="fab fa-paypal"></i> Continue to PayPal</span>
                                <div class="loader d-none" id="paypalLoader"></div>
                            </button>
                        </div>
                    </div>

                    <button type="button" class="btn-cancel" onclick="cancelPayment()">
                        <i class="fas fa-times"></i> Cancel Payment
                    </button>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="card order-summary">
                <div class="card-header">
                    <i class="fas fa-receipt"></i>
                    <h3>Order Summary</h3>
                </div>
                <div class="card-body">
                    <div class="summary-row">
                        <span class="label">Package</span>
                        <span class="value" id="packageName">Loading...</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Destination</span>
                        <span class="value" id="destination">-</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Travel Date</span>
                        <span class="value" id="travelDate">-</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Rooms</span>
                        <span class="value" id="rooms">1</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Guests</span>
                        <span class="value" id="guests">2</span>
                    </div>
                    <div class="summary-row total">
                        <span class="label">Total</span>
                        <span class="value" id="totalPrice">$0</span>
                    </div>

                    <div class="booking-ref">
                        <span>Booking Reference</span>
                        <strong id="bookingRef">-</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var bookingId = @(ViewData["BookingId"] ?? 0);
        var bookingData = null;
        var selectedMethod = 'card';

        // Get booking ID from URL if not set
        if (!bookingId || bookingId === 0) {
            var pathMatch = window.location.pathname.match(/\/payment\/(\d+)/);
            if (pathMatch) {
                bookingId = parseInt(pathMatch[1]);
            }
        }

        // Check for PayPal return
        var urlParams = new URLSearchParams(window.location.search);
        var paypalOrderId = urlParams.get('orderId') || urlParams.get('token');
        var paypalPayerId = urlParams.get('payerId') || urlParams.get('PayerID');
        var wasCancelled = urlParams.get('cancelled');

        function selectPaymentMethod(method) {
            selectedMethod = method;
            
            document.querySelectorAll('.payment-method').forEach(function(el) {
                el.classList.remove('active');
            });
            
            if (method === 'card') {
                document.querySelector('.card-method').classList.add('active');
                document.getElementById('cardPaymentSection').classList.remove('d-none');
                document.getElementById('paypalPaymentSection').classList.add('d-none');
            } else {
                document.querySelector('.paypal-method').classList.add('active');
                document.getElementById('cardPaymentSection').classList.add('d-none');
                document.getElementById('paypalPaymentSection').classList.remove('d-none');
            }
        }

        function showError(message) {
            document.getElementById('errorMessage').textContent = message;
            document.getElementById('errorAlert').classList.remove('d-none');
            document.getElementById('successAlert').classList.add('d-none');
        }

        function showSuccess(message) {
            document.getElementById('successMessage').textContent = message;
            document.getElementById('successAlert').classList.remove('d-none');
            document.getElementById('errorAlert').classList.add('d-none');
        }

        function setButtonLoading(type, loading) {
            var textEl = document.getElementById(type === 'card' ? 'payCardText' : 'paypalText');
            var loaderEl = document.getElementById(type === 'card' ? 'payCardLoader' : 'paypalLoader');
            var btnEl = document.getElementById(type === 'card' ? 'payCardBtn' : 'paypalBtn');

            if (loading) {
                textEl.classList.add('d-none');
                loaderEl.classList.remove('d-none');
                btnEl.disabled = true;
            } else {
                textEl.classList.remove('d-none');
                loaderEl.classList.add('d-none');
                btnEl.disabled = false;
            }
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        async function loadBookingDetails() {
            var token = localStorage.getItem('token');

            if (!token) {
                window.location.href = '/account/login?returnUrl=/booking/payment/' + bookingId;
                return;
            }

            if (!bookingId || bookingId === 0) {
                showError('Invalid booking ID');
                return;
            }

            try {
                var response = await fetch('/api/booking/' + bookingId, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!response.ok) {
                    var errorData = await response.json();
                    showError(errorData.message || 'Booking not found');
                    return;
                }

                var result = await response.json();
                bookingData = result.data;

                if (!bookingData) {
                    showError('Booking not found');
                    return;
                }

                // Update UI
                var pkg = bookingData.package || {};
                document.getElementById('packageName').textContent = pkg.destination || 'Travel Package';
                document.getElementById('destination').textContent = (pkg.destination || '') + ', ' + (pkg.country || '');
                document.getElementById('travelDate').textContent = formatDate(pkg.startDate);
                document.getElementById('rooms').textContent = bookingData.numberOfRooms || 1;
                document.getElementById('guests').textContent = bookingData.numberOfGuests || 2;
                document.getElementById('totalPrice').textContent = '$' + (bookingData.totalPrice || 0).toLocaleString();
                document.getElementById('bookingRef').textContent = bookingData.bookingReference || '-';

            } catch (error) {
                console.error('Error:', error);
                showError('Failed to load booking details');
            }
        }

        // Format card number with spaces
        document.getElementById('cardNumber').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\s/g, '').replace(/\D/g, '');
            var formatted = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formatted;
        });

        // Format expiry date
        document.getElementById('expiry').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2, 4);
            }
            e.target.value = value;
        });

        // CVV - numbers only
        document.getElementById('cvv').addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '').substring(0, 4);
        });

        // Credit Card Payment
        document.getElementById('cardPaymentSection').addEventListener('submit', async function(e) {
            e.preventDefault();

            var cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
            var cardName = document.getElementById('cardName').value.trim();
            var expiry = document.getElementById('expiry').value;
            var cvv = document.getElementById('cvv').value;

            // Validation
            if (cardNumber.length < 13) { showError('Please enter a valid card number'); return; }
            if (!cardName) { showError('Please enter the cardholder name'); return; }

            var expiryParts = expiry.split('/');
            if (expiryParts.length !== 2 || expiryParts[0].length !== 2 || expiryParts[1].length !== 2) {
                showError('Please enter a valid expiry date (MM/YY)');
                return;
            }
            if (cvv.length < 3) { showError('Please enter a valid CVV'); return; }

            setButtonLoading('card', true);

            try {
                var token = localStorage.getItem('token');
                var response = await fetch('/api/payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        bookingId: parseInt(bookingId),
                        cardNumber: cardNumber,
                        cardHolderName: cardName,
                        expiryMonth: parseInt(expiryParts[0]),
                        expiryYear: parseInt('20' + expiryParts[1]),
                        cvv: cvv,
                        paymentMethod: 0
                    })
                });

                var result = await response.json();

                if (result.success) {
                    showSuccess('Payment successful! Redirecting...');
                    setTimeout(function() {
                        window.location.href = '/?payment=success&ref=' + encodeURIComponent(document.getElementById('bookingRef').textContent);
                    }, 2000);
                } else {
                    showError(result.message || 'Payment failed');
                    setButtonLoading('card', false);
                }
            } catch (error) {
                console.error('Error:', error);
                showError('Payment processing error');
                setButtonLoading('card', false);
            }
        });

        // PayPal Payment - Redirects to PayPal
        async function processPayPal() {
            setButtonLoading('paypal', true);
            showSuccess('Initiating PayPal payment...');

            try {
                var token = localStorage.getItem('token');
                var baseUrl = window.location.origin;

                // Step 1: Create PayPal order
                var initiateResponse = await fetch('/api/payment/paypal/initiate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        bookingId: parseInt(bookingId),
                        returnUrl: baseUrl + '/booking/payment/' + bookingId + '?status=success',
                        cancelUrl: baseUrl + '/booking/payment/' + bookingId + '?cancelled=true'
                    })
                });

                if (!initiateResponse.ok) {
                    var errorData = await initiateResponse.json();
                    throw new Error(errorData.message || 'Failed to initiate PayPal');
                }

                var initiateResult = await initiateResponse.json();

                if (!initiateResult.success) {
                    throw new Error(initiateResult.message || 'PayPal initiation failed');
                }

                // Store order ID for when user returns
                sessionStorage.setItem('paypalOrderId', initiateResult.data.orderId);
                sessionStorage.setItem('paypalBookingId', bookingId.toString());

                // Step 2: Redirect to PayPal approval URL
                if (initiateResult.data.approvalUrl) {
                    showSuccess('Redirecting to PayPal...');
                    window.location.href = initiateResult.data.approvalUrl;
                } else {
                    throw new Error('No PayPal approval URL received');
                }

            } catch (error) {
                console.error('PayPal error:', error);
                showError(error.message || 'PayPal payment failed');
                setButtonLoading('paypal', false);
            }
        }

        // Capture PayPal payment after return
        async function capturePayPalPayment(orderId) {
            showSuccess('Completing PayPal payment...');
            setButtonLoading('paypal', true);
            selectPaymentMethod('paypal');

            try {
                var token = localStorage.getItem('token');

                var captureResponse = await fetch('/api/payment/paypal/capture', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        bookingId: parseInt(bookingId),
                        orderId: orderId
                    })
                });

                var captureResult = await captureResponse.json();

                if (captureResult.success) {
                    // Clear session storage
                    sessionStorage.removeItem('paypalOrderId');
                    sessionStorage.removeItem('paypalBookingId');

                    showSuccess('Payment successful! Redirecting...');
                    setTimeout(function() {
                        window.location.href = '/?payment=success&ref=' + encodeURIComponent(document.getElementById('bookingRef').textContent);
                    }, 2000);
                } else {
                    throw new Error(captureResult.message || 'PayPal capture failed');
                }

            } catch (error) {
                console.error('PayPal capture error:', error);
                showError(error.message || 'Failed to complete PayPal payment');
                setButtonLoading('paypal', false);
            }
        }

        function cancelPayment() {
            if (confirm('Are you sure you want to cancel this payment?')) {
                window.location.href = '/account/dashboard';
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadBookingDetails();

            // Check if returning from PayPal
            if (paypalOrderId && !wasCancelled) {
                // User returned from PayPal - capture the payment
                capturePayPalPayment(paypalOrderId);
            } else if (wasCancelled) {
                showError('PayPal payment was cancelled');
            }

            // Also check session storage for PayPal order
            var storedOrderId = sessionStorage.getItem('paypalOrderId');
            var storedBookingId = sessionStorage.getItem('paypalBookingId');
            
            if (storedOrderId && storedBookingId && urlParams.get('status') === 'success') {
                capturePayPalPayment(storedOrderId);
            }
        });
    </script>
</body>
</html>
